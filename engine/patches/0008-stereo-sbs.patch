 /*
+==================
+R_FboInit
+
+Creates the offscreen buffer for r_renderScale < 1 and makes the game see its size.
+Leaves r_fboActive false (full resolution) when the scale is 1 or FBOs are not available.
+==================
+*/
+void R_FboInit( void ) {
+	int w, h;
+	GLenum status;
+
+	r_fboActive = qfalse;
+	r_fbo = r_fboTex = r_fboDepth = 0;
+
+	if ( r_renderScale->value >= 0.99f ) {
+		return;
+	}
+	if ( !qglGenFramebuffers || !qglBindFramebuffer || !qglFramebufferTexture2D || !qglGenRenderbuffers ) {
+		ri.Printf( PRINT_ALL, "r_renderScale: framebuffer objects not available, using full resolution\n" );
+		return;
+	}
+
+	w = ( (int)( r_nativeWidth * r_renderScale->value ) ) & ~1;
+	h = ( (int)( r_nativeHeight * r_renderScale->value ) ) & ~1;
+	if ( w < 320 ) w = 320;
+	if ( h < 240 ) h = 240;
+
+	qglGenTextures( 1, &r_fboTex );
+	qglBindTexture( GL_TEXTURE_2D, r_fboTex );
+	qglTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR );
+	qglTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR );
+	qglTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE );
+	qglTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE );
+	qglTexImage2D( GL_TEXTURE_2D, 0, GL_RGBA, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL );
+
+	qglGenRenderbuffers( 1, &r_fboDepth );
+	qglBindRenderbuffer( GL_RENDERBUFFER, r_fboDepth );
+	qglRenderbufferStorage( GL_RENDERBUFFER, GL_DEPTH24_STENCIL8, w, h );
+
+	qglGenFramebuffers( 1, &r_fbo );
+	qglBindFramebuffer( GL_FRAMEBUFFER, r_fbo );
+	qglFramebufferTexture2D( GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, r_fboTex, 0 );
+	qglFramebufferRenderbuffer( GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, r_fboDepth );
+	qglFramebufferRenderbuffer( GL_FRAMEBUFFER, GL_STENCIL_ATTACHMENT, GL_RENDERBUFFER, r_fboDepth );
+	status = qglCheckFramebufferStatus( GL_FRAMEBUFFER );
+	qglBindFramebuffer( GL_FRAMEBUFFER, 0 );
+	qglBindTexture( GL_TEXTURE_2D, 0 );
+
+	if ( status != GL_FRAMEBUFFER_COMPLETE ) {
+		ri.Printf( PRINT_ALL, "r_renderScale: framebuffer incomplete (0x%x), using full resolution\n", status );
+		R_FboShutdown();
+		return;
+	}
+
+	r_fboActive = qtrue;
+	glConfig.vidWidth = w;
+	glConfig.vidHeight = h;
+	ri.Printf( PRINT_ALL, "r_renderScale %.2f: rendering %dx%d, window %dx%d\n",
+		r_renderScale->value, w, h, r_nativeWidth, r_nativeHeight );
+}
+
+void R_FboShutdown( void ) {
+	if ( r_fbo && qglDeleteFramebuffers ) {
+		qglBindFramebuffer( GL_FRAMEBUFFER, 0 );
+		qglDeleteFramebuffers( 1, &r_fbo );
+		qglDeleteRenderbuffers( 1, &r_fboDepth );
+		qglDeleteTextures( 1, &r_fboTex );
+	}
+	r_fbo = r_fboTex = r_fboDepth = 0;
+	r_fboActive = qfalse;
+}
+
