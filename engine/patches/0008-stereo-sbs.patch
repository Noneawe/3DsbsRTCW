 /*
 =============
+RB_PresentFbo
+
+Draws the offscreen picture (r_renderScale) over the whole window.
+=============
+*/
+void RB_PresentFbo( void ) {
+	qglBindFramebuffer( GL_FRAMEBUFFER, 0 );
+	qglColorMask( GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE );
+	qglViewport( 0, 0, r_nativeWidth, r_nativeHeight );
+	qglScissor( 0, 0, r_nativeWidth, r_nativeHeight );
+
+	qglMatrixMode( GL_PROJECTION );
+	qglLoadIdentity();
+	qglOrtho( 0, 1, 0, 1, -1, 1 );
+	qglMatrixMode( GL_MODELVIEW );
+	qglLoadIdentity();
+
+	GL_State( GLS_DEPTHTEST_DISABLE );
+	GL_Cull( CT_TWO_SIDED );
+
+	qglBindTexture( GL_TEXTURE_2D, r_fboTex );
+	glState.currenttextures[glState.currenttmu] = -1;	// not the texture GL_Bind thinks it is
+
+	qglColor4f( 1, 1, 1, 1 );
+	qglBegin( GL_QUADS );
+	qglTexCoord2f( 0, 0 );	qglVertex2f( 0, 0 );
+	qglTexCoord2f( 1, 0 );	qglVertex2f( 1, 0 );
+	qglTexCoord2f( 1, 1 );	qglVertex2f( 1, 1 );
+	qglTexCoord2f( 0, 1 );	qglVertex2f( 0, 1 );
+	qglEnd();
+
+	backEnd.projection2D = qfalse;
+}
