diff --git a/SP/code/sdl/sdl_input.c b/SP/code/sdl/sdl_input.c
index 3bd4f23..0c2b115 100644
--- a/SP/code/sdl/sdl_input.c
+++ b/SP/code/sdl/sdl_input.c
@@ -455,6 +455,7 @@ static void IN_InitJoystick( void )
 {
 	int i = 0;
 	int total = 0;
+	int joyIndex;
 	char buf[16384] = "";
 
 	if (gamepad)
@@ -502,6 +503,7 @@ static void IN_InitJoystick( void )
 	{
 		Q_strcat(buf, sizeof(buf), SDL_JoystickNameForIndex(i));
 		Q_strcat(buf, sizeof(buf), "\n");
+		Com_Printf("Joystick %d: %s%s\n", i, SDL_JoystickNameForIndex(i), SDL_IsGameController(i) ? " (game controller)" : "");
 	}
 
 	Cvar_Get( "in_availableJoysticks", "", CVAR_ROM );
@@ -521,24 +523,39 @@ static void IN_InitJoystick( void )
 
 	in_joystickUseAnalog = Cvar_Get( "in_joystickUseAnalog", "0", CVAR_ARCHIVE );
 
-	stick = SDL_JoystickOpen( in_joystickNo->integer );
+	// Android lists virtual devices (vendor uinput, accelerometer) before real pads: unless the selected
+	// device is a game controller, use the first one that is
+	joyIndex = in_joystickNo->integer;
+	if (!SDL_IsGameController(joyIndex))
+	{
+		for (i = 0; i < total; i++)
+		{
+			if (SDL_IsGameController(i))
+			{
+				joyIndex = i;
+				break;
+			}
+		}
+	}
+
+	stick = SDL_JoystickOpen( joyIndex );
 
 	if (stick == NULL) {
 		Com_DPrintf( "No joystick opened: %s\n", SDL_GetError() );
 		return;
 	}
 
-	if (SDL_IsGameController(in_joystickNo->integer))
-		gamepad = SDL_GameControllerOpen(in_joystickNo->integer);
+	if (SDL_IsGameController(joyIndex))
+		gamepad = SDL_GameControllerOpen(joyIndex);
 
-	Com_DPrintf( "Joystick %d opened\n", in_joystickNo->integer );
-	Com_DPrintf( "Name:       %s\n", SDL_JoystickNameForIndex(in_joystickNo->integer) );
-	Com_DPrintf( "Axes:       %d\n", SDL_JoystickNumAxes(stick) );
-	Com_DPrintf( "Hats:       %d\n", SDL_JoystickNumHats(stick) );
-	Com_DPrintf( "Buttons:    %d\n", SDL_JoystickNumButtons(stick) );
-	Com_DPrintf( "Balls:      %d\n", SDL_JoystickNumBalls(stick) );
-	Com_DPrintf( "Use Analog: %s\n", in_joystickUseAnalog->integer ? "Yes" : "No" );
-	Com_DPrintf( "Is gamepad: %s\n", gamepad ? "Yes" : "No" );
+	Com_Printf( "Joystick %d opened\n", joyIndex );
+	Com_Printf( "Name:       %s\n", SDL_JoystickNameForIndex(joyIndex) );
+	Com_Printf( "Axes:       %d\n", SDL_JoystickNumAxes(stick) );
+	Com_Printf( "Hats:       %d\n", SDL_JoystickNumHats(stick) );
+	Com_Printf( "Buttons:    %d\n", SDL_JoystickNumButtons(stick) );
+	Com_Printf( "Balls:      %d\n", SDL_JoystickNumBalls(stick) );
+	Com_Printf( "Use Analog: %s\n", in_joystickUseAnalog->integer ? "Yes" : "No" );
+	Com_Printf( "Is gamepad: %s\n", gamepad ? "Yes" : "No" );
 
 	SDL_JoystickEventState(SDL_QUERY);
 	SDL_GameControllerEventState(SDL_QUERY);
@@ -1210,6 +1227,19 @@ void IN_Frame( void )
 	else
 		IN_ActivateMouse( cls.glconfig.isFullscreen );
 
+#ifdef __ANDROID__
+	{
+		qboolean wantText = ( Key_GetCatcher( ) & ( KEYCATCH_CONSOLE | KEYCATCH_MESSAGE ) ) != 0;
+		if( wantText != ( SDL_IsTextInputActive( ) != SDL_FALSE ) )
+		{
+			if( wantText )
+				SDL_StartTextInput( );
+			else
+				SDL_StopTextInput( );
+		}
+	}
+#endif
+
 	IN_ProcessEvents( );
 
 	// Set event time for next frame to earliest possible time an event could happen
@@ -1251,7 +1281,11 @@ void IN_Init( void *windowData )
 	in_joystick = Cvar_Get( "in_joystick", "0", CVAR_ARCHIVE|CVAR_LATCH );
 	in_joystickThreshold = Cvar_Get( "joy_threshold", "0.15", CVAR_ARCHIVE );
 
+#ifndef __ANDROID__
 	SDL_StartTextInput( );
+#else
+	// on Android the soft keyboard is only wanted for the console / chat (see IN_Frame)
+#endif
 
 	mouseAvailable = ( in_mouse->value != 0 );
 	IN_DeactivateMouse( Cvar_VariableIntegerValue( "r_fullscreen" ) != 0 );
