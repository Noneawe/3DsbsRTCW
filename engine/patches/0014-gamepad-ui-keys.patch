+// Gamepad: LB/RB switch the tabs (buttons named ctr_*) of the focused menu, A confirms the pregame (Continue) screen.
+static int UI_TabCompare( const void *a, const void *b ) {
+	return (int)( ( *(itemDef_t **)a )->window.rect.x - ( *(itemDef_t **)b )->window.rect.x );
+}
+
+static qboolean UI_PadMenuKey( menuDef_t *menu, int key ) {
+	itemDef_t *tabs[64];
+	static menuDef_t *lastMenu;
+	static int cur;
+	int i, n = 0;
+
+	if ( key == K_ENTER && !Q_stricmp( menu->window.name, "pregame" ) ) {
+		for ( i = 0; i < menu->itemCount; i++ ) {
+			itemDef_t *it = menu->items[i];
+			if ( it->type == ITEM_TYPE_BUTTON && it->action ) {
+				Item_RunScript( it, it->action );
+				return qtrue;
+			}
+		}
+		return qfalse;
+	}
+
+	if ( key != K_PAD0_LEFTSHOULDER && key != K_PAD0_RIGHTSHOULDER ) {
+		return qfalse;
+	}
+	for ( i = 0; i < menu->itemCount && n < 64; i++ ) {
+		itemDef_t *it = menu->items[i];
+		if ( it->type == ITEM_TYPE_BUTTON && it->action && !Q_stricmpn( it->window.name, "ctr_", 4 ) ) {
+			tabs[n++] = it;
+		}
+	}
+	if ( n < 2 ) {
+		return qtrue;
+	}
+	qsort( tabs, n, sizeof( tabs[0] ), UI_TabCompare );
+	if ( menu != lastMenu ) {   // ponytail: the opened tab is not tracked, the first press starts from the leftmost one
+		lastMenu = menu;
+		cur = 0;
+	}
+	cur = ( cur + ( key == K_PAD0_RIGHTSHOULDER ? 1 : n - 1 ) ) % n;
+	Item_RunScript( tabs[cur], tabs[cur]->action );
+	return qtrue;
+}
