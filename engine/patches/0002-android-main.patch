 }
@@ -734,6 +741,39 @@ int main( int argc, char **argv )
 	Sys_SetBinaryPath( Sys_Dirname( argv[ 0 ] ) );
 	Sys_SetDefaultInstallPath( DEFAULT_BASEDIR );
 
+#ifdef __ANDROID__
+	{
+		// Game files live in Android/data/<package>/files (main/pak0.pk3 goes there)
+		const char *dir = SDL_AndroidGetExternalStoragePath( );
+
+		if( dir )
+		{
+			// create the game dir so users can drop pak0.pk3 in (and it is owned by the app)
+			char base[ MAX_OSPATH ];
+			Com_sprintf( base, sizeof( base ), "%s/main", dir );
+			mkdir( base, 0770 );
+
+			// first run (no saved config): apply default gamepad bindings
+			Com_sprintf( base, sizeof( base ), "%s/main/wolfconfig.cfg", dir );
+			if( access( base, F_OK ) != 0 )
+				Q_strcat( commandLine, sizeof( commandLine ), "+exec pad_defaults.cfg " );
+
+			// optional startup.cfg next to pak0.pk3: run once the commands (map, devmap...) exist, for testing
+			Com_sprintf( base, sizeof( base ), "%s/main/startup.cfg", dir );
+			if( access( base, R_OK ) == 0 )
+				Q_strcat( commandLine, sizeof( commandLine ), "+exec startup.cfg " );
+
+			Q_strcat( commandLine, sizeof( commandLine ), "+set fs_basepath \"" );
+			Q_strcat( commandLine, sizeof( commandLine ), dir );
+			Q_strcat( commandLine, sizeof( commandLine ), "\" +set fs_homepath \"" );
+			Q_strcat( commandLine, sizeof( commandLine ), dir );
+			Q_strcat( commandLine, sizeof( commandLine ), "\" " );
+		}
+		Q_strcat( commandLine, sizeof( commandLine ),
+			"+set r_fullscreen 1 +set r_mode -2 +set s_useOpenAL 0 +set in_joystick 1 " );
+	}
+#endif
+
 	// Concatenate the command line for passing to Com_Init
