+/*
+=================
+CG_AimAssist
+
+Single player, gamepad: slow the stick look down while the crosshair is near a visible enemy, so small
+corrections are possible. Hands the factor to the client through j_aimScale (see CL_JoystickMove).
+Strength is cg_aimAssist (0 = off, 1 = look speed drops to 35%).
+=================
+*/
+static void CG_AimAssist( void ) {
+	static float lastScale = 1;
+	float scale = 1, bestAng = 1e9f;
+	int num;
+	vec3_t start;
+
+	if ( cg_aimAssist.value > 0 && cgs.gametype == GT_SINGLE_PLAYER && cg.snap && !cg.cameraMode
+		 && cg.snap->ps.pm_type == PM_NORMAL && !( cg.snap->ps.eFlags & EF_DEAD ) ) {
+		VectorCopy( cg.refdef.vieworg, start );
+
+		for ( num = 0; num < cg.snap->numEntities; num++ ) {
+			entityState_t *es = &cg.snap->entities[num];
+			vec3_t dir, tgt;
+			trace_t tr;
+			float dist, ang;
+
+			// live AI soldiers / monsters of another team than the player
+			if ( es->eType != ET_PLAYER || ( es->eFlags & EF_DEAD ) || es->teamNum == cg.snap->ps.teamNum
+				 || es->teamNum == 7 /* AITEAM_NEUTRAL */ || es->number == cg.snap->ps.clientNum ) {
+				continue;
+			}
+			VectorCopy( cg_entities[es->number].lerpOrigin, tgt );
+			tgt[2] += 36;   // chest
+			VectorSubtract( tgt, start, dir );
+			dist = VectorNormalize( dir );
+			if ( dist < 1 || dist > 3000 ) {
+				continue;
+			}
+			ang = acos( DotProduct( dir, cg.refdef.viewaxis[0] ) );
+			// target radius ~ 22 units seen from dist, plus a little margin
+			if ( ang > atan2( 22, dist ) + 0.03f || ang >= bestAng ) {
+				continue;
+			}
+			CG_Trace( &tr, start, vec3_origin, vec3_origin, tgt, cg.snap->ps.clientNum, CONTENTS_SOLID );
+			if ( tr.fraction < 0.99f ) {
+				continue;
+			}
+			bestAng = ang;
+			scale = 1.0f - 0.65f * ( cg_aimAssist.value > 1 ? 1 : cg_aimAssist.value );
+		}
+	}
+
+	if ( scale != lastScale ) {
+		lastScale = scale;
+		trap_Cvar_Set( "j_aimScale", va( "%.2f", scale ) );
+	}
+}
