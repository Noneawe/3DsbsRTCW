 /*
 ==============
+Gamepad settings (System -> Pad tab, added at install time): one cvar per action holds the name of the pad
+button bound to it ("none" = unbound). padLoad reads the binds into the cvars, padApply writes them back.
+==============
+*/
+static const struct { const char *cvar, *cmd; } uiPadActions[] = {
+	{ "ui_pad_fire", "+attack" }, { "ui_pad_zoom", "+zoom" }, { "ui_pad_jump", "+moveup" },
+	{ "ui_pad_crouch", "+movedown" }, { "ui_pad_reload", "+reload" }, { "ui_pad_use", "+activate" },
+	{ "ui_pad_next", "weapnext" }, { "ui_pad_prev", "weapprev" }, { "ui_pad_alt", "weapalt" },
+	{ "ui_pad_notes", "notebook" }, { "ui_pad_leanl", "+leanleft" }, { "ui_pad_leanr", "+leanright" },
+	{ "ui_pad_sprint", "+sprint" }, { "ui_pad_kick", "+kick" }, { "ui_pad_obj", "+scores" },
+};
+static const int uiPadKeys[] = {
+	K_PAD0_A, K_PAD0_B, K_PAD0_X, K_PAD0_Y, K_PAD0_BACK, K_PAD0_START, K_PAD0_LEFTSTICK_CLICK,
+	K_PAD0_RIGHTSTICK_CLICK, K_PAD0_LEFTSHOULDER, K_PAD0_RIGHTSHOULDER, K_PAD0_DPAD_UP, K_PAD0_DPAD_DOWN,
+	K_PAD0_DPAD_LEFT, K_PAD0_DPAD_RIGHT, K_PAD0_LEFTTRIGGER, K_PAD0_RIGHTTRIGGER,
+};
+#define UI_PAD_ACTIONS ( sizeof( uiPadActions ) / sizeof( uiPadActions[0] ) )
+#define UI_PAD_KEYS ( sizeof( uiPadKeys ) / sizeof( uiPadKeys[0] ) )
+
+static void UI_PadLoad( void ) {
+	unsigned a, k;
+	char bind[MAX_STRING_CHARS], name[64];
+
+	for ( a = 0; a < UI_PAD_ACTIONS; a++ ) {
+		Q_strncpyz( name, "none", sizeof( name ) );
+		for ( k = 0; k < UI_PAD_KEYS; k++ ) {
+			trap_Key_GetBindingBuf( uiPadKeys[k], bind, sizeof( bind ) );
+			if ( !Q_stricmp( bind, uiPadActions[a].cmd ) ) {
+				trap_Key_KeynumToStringBuf( uiPadKeys[k], name, sizeof( name ) );
+				break;
+			}
+		}
+		trap_Cvar_Set( uiPadActions[a].cvar, name );
+	}
+}
+
+static void UI_PadApply( void ) {
+	unsigned a, k;
+	char bind[MAX_STRING_CHARS], name[64], want[64];
+
+	for ( a = 0; a < UI_PAD_ACTIONS; a++ ) {
+		// free the buttons this action had, then take the chosen one (it may move from another action)
+		for ( k = 0; k < UI_PAD_KEYS; k++ ) {
+			trap_Key_GetBindingBuf( uiPadKeys[k], bind, sizeof( bind ) );
+			if ( !Q_stricmp( bind, uiPadActions[a].cmd ) ) {
+				trap_Key_SetBinding( uiPadKeys[k], "" );
+			}
+		}
+		trap_Cvar_VariableStringBuffer( uiPadActions[a].cvar, want, sizeof( want ) );
+		for ( k = 0; k < UI_PAD_KEYS; k++ ) {
+			trap_Key_KeynumToStringBuf( uiPadKeys[k], name, sizeof( name ) );
+			if ( !Q_stricmp( name, want ) ) {
+				trap_Key_SetBinding( uiPadKeys[k], uiPadActions[a].cmd );
+				break;
+			}
+		}
+	}
+	UI_PadLoad();	// an action that lost its button to another one shows "none"
+}
+
