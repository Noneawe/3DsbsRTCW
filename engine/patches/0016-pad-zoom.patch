 	void ( *function )( void );
 } consoleCommand_t;
 
+/*
+=================
+CG_PadZoomDown_f / CG_PadZoomUp_f
+
+One zoom button for the gamepad: with a scoped weapon (Mauser, FG42, Garand or their scope mode) it toggles
+the scope like the alt-fire key, otherwise it holds the binoculars (+zoom, needs the binoculars item).
+=================
+*/
+static qboolean padZoomBinoc;
+
+static void CG_PadZoomDown_f( void ) {
+	switch ( cg.snap->ps.weapon ) {
+	case WP_MAUSER: case WP_GARAND: case WP_FG42:
+	case WP_SNIPERRIFLE: case WP_SNOOPERSCOPE: case WP_FG42SCOPE:
+		padZoomBinoc = qfalse;
+		CG_AltWeapon_f();
+		break;
+	default:
+		padZoomBinoc = qtrue;
+		trap_SendConsoleCommand( "+zoom\n" );
+	}
+}
+
+static void CG_PadZoomUp_f( void ) {
+	if ( padZoomBinoc ) {
+		padZoomBinoc = qfalse;
+		trap_SendConsoleCommand( "-zoom\n" );
+	}
+}
+
 static consoleCommand_t commands[] = {
 	{ "testgun", CG_TestGun_f },
 	{ "testmodel", CG_TestModel_f },
