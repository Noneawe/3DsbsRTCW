itemDef {
	name stereo
	group grpSystem
	text "Apply (restarts video)"
	type ITEM_TYPE_BUTTON
	style WINDOW_STYLE_FILLED
	textscale .25
	rect 141 252 180 20
	textalign 1
	textalignx 90
	textaligny 15
	forecolor 1 1 1 1
	backcolor .1 .1 .1 .1
	visible 0
	border 1
	bordercolor .5 .5 .5 .5
	action { play "sound/misc/kcaction.wav" ; exec "vid_restart" }
	mouseEnter { setitemcolor stereo backcolor .3 .5 .2 .25 }
	mouseExit { setitemcolor stereo backcolor .1 .1 .1 .1 }
}

