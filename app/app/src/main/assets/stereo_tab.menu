	textalign 1
	textalignx 90
	textaligny 12
	forecolor 1 1 1 1
	backcolor .1 .1 .1 .1
	visible 0
	border 1
	bordercolor .5 .5 .5 .5
	action { play "sound/misc/kcaction.wav" ; uiScript padReset }
	mouseEnter { setitemcolor pad backcolor .3 .5 .2 .25 }
	mouseExit { setitemcolor pad backcolor .1 .1 .1 .1 }
}
