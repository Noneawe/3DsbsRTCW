// 3DRTCW: "3D" and "Pad" tabs added to the System menu at install time (see PakCheckActivity.installMenus).
// Adjacent quoted strings are merged by the menu parser: cvarStrList entries need commas.
// Items sit in the menu's grpSystem group, so the menu's own onOpen/tab scripts hide and show them.

itemDef {
	name ctr_stereo
	text "3D"
	type ITEM_TYPE_BUTTON
	textscale .22
	group grpSystembutton
	style WINDOW_STYLE_FILLED
	rect 6 10 44 12
	textalign 1
	textalignx 22
	textaligny 10
	forecolor .9 .9 .9 .8
	backcolor .1 .1 .1 0
	visible 1
	action { play "sound/misc/kcaction.wav" ; hide grpSystem ; hide grpapplysystem ; hide graphicsapply ; show stereo }
}

itemDef {
	name stereo
	group grpSystem
	style 1
	text "3D Settings"
	rect 163 30 128 20
	textalign ITEM_ALIGN_CENTER
	textalignx 64
	textaligny 20
	textscale .22
	forecolor .9 .9 .9 .9
	visible 0
	decoration
}

itemDef {
	name stereo
	group grpSystem
	type ITEM_TYPE_SLIDER
	text "3D Depth:"
	cvarfloat "r_stereoSeparation" 1 0 2
	rect 82 60 290 12
	textalign ITEM_ALIGN_RIGHT
	textalignx 142
	textaligny 10
	textscale .22
	style WINDOW_STYLE_FILLED
	backcolor 1 1 1 .07
	forecolor 1 1 1 1
	visible 0
}

